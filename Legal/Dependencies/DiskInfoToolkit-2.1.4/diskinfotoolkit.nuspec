<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DiskInfoToolkit</id>
    <version>2.1.4</version>
    <authors>DiskInfoToolkit</authors>
    <license type="expression">MPL-2.0</license>
    <licenseUrl>https://licenses.nuget.org/MPL-2.0</licenseUrl>
    <icon>packageicon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Blacktempel/DiskInfoToolkit</projectUrl>
    <description>A toolkit for accessing disk data.</description>
    <copyright>Florian K.</copyright>
    <tags>disk device nvme ssd hdd toolkit thermal sensor thermal sensor smart s.m.a.r.t. data monitoring system disk info</tags>
    <repository type="git" url="https://github.com/Blacktempel/DiskInfoToolkit" commit="a6ea726b6118d4469d1228e19b5db0f3437864dc" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.8.1">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="BlackSharp.Core" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>