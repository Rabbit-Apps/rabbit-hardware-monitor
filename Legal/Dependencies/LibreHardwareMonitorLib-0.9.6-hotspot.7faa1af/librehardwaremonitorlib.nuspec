        <dependency id="System.IO.FileSystem.AccessControl" version="5.0.0" exclude="Build,Analyzers" />
        <dependency id="System.IO.Ports" version="10.0.11" exclude="Build,Analyzers" />
        <dependency id="System.Management" version="10.0.11" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
